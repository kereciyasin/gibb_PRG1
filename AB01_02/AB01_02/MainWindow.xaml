<Window x:Class="AB01_02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weather App" Height="450" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Background="#F3F4F6">
        <StackPanel Margin="20">
            <TextBlock Text="Weather App"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#374151"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <Label Content="Latitude:"
                   FontSize="14"
                   Foreground="#6B7280"
                   Margin="0,0,0,5"/>
            <TextBox x:Name="LatitudeTextBox"
                     Height="30"
                     Background="#FFFFFF"
                     BorderBrush="#D1D5DB"
                     Margin="0,0,0,10"
                     Padding="5"/>

            <Label Content="Longitude:"
                   FontSize="14"
                   Foreground="#6B7280"
                   Margin="0,0,0,5"/>
            <TextBox x:Name="LongitudeTextBox"
                     Height="30"
                     Background="#FFFFFF"
                     BorderBrush="#D1D5DB"
                     Margin="0,0,0,10"
                     Padding="5"/>

            <Button Content="Fetch Weather by Coordinates"
                    Width="200"
                    Height="35"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderBrush="#2563EB"
                    HorizontalAlignment="Center"
                    Click="FetchWeatherByCoordinatesButton_Click"/>

            <TextBlock x:Name="WeatherTextBlock"
                       Text="Weather details will appear here..."
                       TextWrapping="Wrap"
                       Foreground="#374151"
                       Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>
