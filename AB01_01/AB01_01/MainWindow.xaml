<Window x:Class="AB01_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login System" Height="450" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Background="#F3F4F6">
        <Border Margin="20" CornerRadius="10" Background="White" Padding="20" BorderBrush="#D1D5DB" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Login System" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#4B5563" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>

                <Label Content="Email:" 
                       Foreground="#6B7280" 
                       FontSize="14" 
                       Margin="0,0,0,5"/>
                <TextBox x:Name="EmailTextBox" 
                         Height="30" 
                         BorderBrush="#D1D5DB" 
                         BorderThickness="1" 
                         Background="#F9FAFB" 
                         Margin="0,0,0,15" 
                         Padding="5"/>

                <Label Content="Password:" 
                       Foreground="#6B7280" 
                       FontSize="14" 
                       Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" 
                             Height="30" 
                             BorderBrush="#D1D5DB" 
                             BorderThickness="1" 
                             Background="#F9FAFB" 
                             Margin="0,0,0,20" 
                             Padding="5"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Login" 
                            Width="100" 
                            Height="35" 
                            Background="#2563EB" 
                            Foreground="White" 
                            FontWeight="Bold" 
                            BorderBrush="#2563EB" 
                            BorderThickness="0" 
                            Margin="5" 
                            Cursor="Hand" 
                            Click="LoginButton_Click"/>

                    <Button Content="Reset" 
                            Width="100" 
                            Height="35" 
                            Background="#E5E7EB" 
                            Foreground="#374151" 
                            FontWeight="Bold" 
                            BorderBrush="#E5E7EB" 
                            BorderThickness="0" 
                            Margin="5" 
                            Cursor="Hand" 
                            Click="ResetButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
