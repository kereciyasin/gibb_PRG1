<Window x:Class="AB01_03.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send Email" Height="300" Width="400">
    <Grid>
        <TextBox Name="emailTextBox" Width="231" Height="19" Margin="0,50,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Text="Recipient Email"/>
        <Button Name="sendButton" Content="Send Email" Width="150" Height="40" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="50,100,50,0" Click="SendButton_Click"/>
    </Grid>
</Window>